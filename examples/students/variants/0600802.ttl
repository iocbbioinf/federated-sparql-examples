@prefix ex: <https://idsm.elixir-czech.cz/.well-known/federated-sparql-examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:0600802 a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:comment "Which molecules have a structural similarity of at least 0.9 to ibuprofen, and what are their Wikidata labels?"@en ;
    spex:federatesWith <https://idsm.elixir-czech.cz/sparql/endpoint/idsm> ;
    spex:federatesWith <https://query.wikidata.org/sparql> ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sachem: <http://bioinfo.uochb.cas.cz/rdf/v1.0/sachem#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

SELECT ?compound ?score ?label WHERE {
  SERVICE <https://idsm.elixir-czech.cz/sparql/endpoint/idsm> {
    [ sachem:compound ?compound ; sachem:score ?score ]
        sachem:similaritySearch [
          sachem:query  "CC(C)CC1=CC=C(C=C1)C(C)C(=O)O" ;
          sachem:cutoff "0.9"^^xsd:double ] .
    GRAPH <http://rdf.ncbi.nlm.nih.gov/pubchem/compound> {
      ?compound rdfs:seeAlso ?wdid .
    }
    FILTER(CONTAINS(STR(?wdid), "http://www.wikidata.org/entity/"))

    SERVICE <https://query.wikidata.org/sparql> {
      ?wdid rdfs:label ?label .
      FILTER(LANG(?label) = "en")
    }
  }
}""" ;
    schema:target <https://sparql.uniprot.org/sparql> .
