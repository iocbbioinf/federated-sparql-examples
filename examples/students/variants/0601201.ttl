@prefix ex: <https://idsm.elixir-czech.cz/.well-known/federated-sparql-examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:0601201 a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:comment "Which chosen sterol-pathway compounds (squalene, 2,3-oxidosqualene, lanosterol, cholesterol, ergosterol) take part in at least three Rhea reactions, and in which reactions?"@en ;
    spex:federatesWith <https://sparql.rhea-db.org/sparql> ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX obo:  <http://purl.obolibrary.org/obo/>
PREFIX rh:   <http://rdf.rhea-db.org/>

SELECT ?chebi (SAMPLE(?name) AS ?label)
       (COUNT(DISTINCT ?rhea) AS ?reactionCount)
       (GROUP_CONCAT(DISTINCT ?rheaId; SEPARATOR=", ") AS ?reactions)
WHERE {
  VALUES ?chebi {
    obo:CHEBI_15440
    obo:CHEBI_15441
    obo:CHEBI_16521
    obo:CHEBI_16113
    obo:CHEBI_16933
  }
  ?chebi rdfs:label ?name .

  SERVICE <https://sparql.rhea-db.org/sparql> {
    ?rhea rdfs:subClassOf rh:Reaction ;
          rh:side/rh:contains/rh:compound ?compound .
    ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi/rh:chebi) ?chebi .
    BIND(STRAFTER(STR(?rhea), "http://rdf.rhea-db.org/") AS ?rheaId)
  }
}
GROUP BY ?chebi
HAVING (COUNT(DISTINCT ?rhea) >= 3)
ORDER BY DESC(?reactionCount)""" ;
    schema:target <https://idsm.elixir-czech.cz/sparql/endpoint/idsm> .
