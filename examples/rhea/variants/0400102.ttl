@prefix ex: <https://idsm.elixir-czech.cz/.well-known/federated-sparql-examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:0400102 a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:comment "For each cholesterol derivative (compound containing the cholesterol skeleton) found in Rhea, count the approved Rhea reactions in which it participates, sorted by the number of reactions"@en ;
    spex:federatesWith <https://idsm.elixir-czech.cz/sparql/endpoint/chebi> ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX rdfs:<http://www.w3.org/2000/01/rdf-schema#>
PREFIX sachem: <http://bioinfo.uochb.cas.cz/rdf/v1.0/sachem#>
PREFIX endpoint: <https://idsm.elixir-czech.cz/sparql/endpoint/>
PREFIX up:<http://purl.uniprot.org/core/>
PREFIX rh:<http://rdf.rhea-db.org/>
PREFIX ch:<http://purl.obolibrary.org/obo/>

SELECT ?CHEBI ?CHEBI_UNIPROT_NAME (count(distinct ?RHEA_REACTION) AS ?RHEA_REACTION_COUNT) WHERE {
  SERVICE endpoint:chebi {
    ?CHEBI sachem:substructureSearch [
        sachem:query "C1C2(C3(CCC4(C(C3(CC=C2CC(C1)O))(CCC4(C(C)CCCC(C)C)))C))C" ].
  }

  ?RHEA_REACTION rdfs:subClassOf rh:Reaction.
  ?RHEA_REACTION rh:status rh:Approved.
  ?RHEA_REACTION rh:side / rh:contains / rh:compound / rh:chebi ?CHEBI.
  ?CHEBI up:name ?CHEBI_UNIPROT_NAME.
}
GROUP BY ?CHEBI ?CHEBI_UNIPROT_NAME
ORDER BY DESC(?RHEA_REACTION_COUNT)""" ;
    schema:target <https://sparql.rhea-db.org/sparql> .
