@prefix ex: <https://idsm.elixir-czech.cz/.well-known/federated-sparql-examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:0300702 a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:comment "How to retrieve the English aliases (alternative names) and the English description of Paracetamol (CID 1983) from Wikidata?"@en ;
    spex:federatesWith <https://query.wikidata.org/sparql> ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX schema: <http://schema.org/>
PREFIX compound: <http://rdf.ncbi.nlm.nih.gov/pubchem/compound/>

SELECT ?wdent ?alias ?description
WHERE {
  GRAPH <http://rdf.ncbi.nlm.nih.gov/pubchem/compound> {
    compound:CID1983 rdfs:seeAlso ?wdent .
  }

  SERVICE <https://query.wikidata.org/sparql> {
    ?wdent skos:altLabel ?alias ;
           schema:description ?description .
    FILTER (LANG(?alias) = "en" && LANG(?description) = "en")
  }
}""" ;
    schema:target <https://idsm.elixir-czech.cz/sparql/endpoint/idsm> .
