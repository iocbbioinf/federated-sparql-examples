@prefix ex: <https://idsm.elixir-czech.cz/.well-known/federated-sparql-examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:0300902 a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:comment "For each organism, how many WikiPathways include the compound ATP (CID 5957)?"@en ;
    spex:federatesWith <https://sparql.wikipathways.org/sparql> ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>
PREFIX bp3: <http://www.biopax.org/release/biopax-level3.owl#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX pav: <http://purl.org/pav/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX compound: <http://rdf.ncbi.nlm.nih.gov/pubchem/compound/>

SELECT ?organism (COUNT(DISTINCT ?wpid) AS ?count)
WHERE {
    GRAPH <http://rdf.ncbi.nlm.nih.gov/pubchem/pathway> {
      ?pathway a bp3:Pathway ;
                rdfs:seeAlso ?wp ;
                obo:RO_0000057 compound:CID5957 .
      FILTER (CONTAINS(STR(?wp), 'wikipathways'))
    }

    BIND (IRI(REPLACE(STR(?wp), 'http://identifiers.org/wikipathways:', 'https://identifiers.org/wikipathways/')) AS ?wikipathways)

    SERVICE <https://sparql.wikipathways.org/sparql> {
      ?wikipathways a wp:Pathway ;
                    dcterms:identifier ?wpid ;
                    pav:hasVersion ?version .
      ?version wp:organismName ?organism .
    }
}
GROUP BY ?organism
ORDER BY DESC(?count)""" ;
    schema:target <https://idsm.elixir-czech.cz/sparql/endpoint/idsm> .
